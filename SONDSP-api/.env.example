# Senha de conexao com o banco
DB_PASSWORD=
# Host do servidor SMTP
MAIL_HOST=
# Porta do servidor SMTP
MAIL_PORT=2525
# Usuario/credencial de autenticacao SMTP
MAIL_USERNAME=
# Senha da credencial SMTP
MAIL_PASSWORD=
# Endereco de e-mail do remetente exibido nas mensagens
MAIL_FROM=
# Chave secreta para assinatura e validacao de tokens JWT
JWT_SECRET=
# Porta do servidor da aplicacao
PORT=8081
# URL base da aplicacao frontend
FRONTEND_URL=http://localhost:5173
# Tempo de expiracao do link de recuperacao de senha (em minutos)
PASSWORD_RESET_EXPIRATION_MINUTES=15
# Tempo de validade do codigo de primeiro acesso / ativacao de conta (em dias)
ACCOUNT_ACTIVATION_EXPIRATION_DAYS=3